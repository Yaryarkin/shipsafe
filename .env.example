# All variables are optional. Copy this file to .env.local for local development,
# or set them in Vercel → Project → Settings → Environment Variables.

# Checkout link for the "Get Full Repo & RLS Audit ($49)" modal (Stripe Payment Link or Gumroad URL).
# When set, the modal shows a checkout button instead of the waitlist form.
NEXT_PUBLIC_PRO_CHECKOUT_URL=

# Public URL used in the "Copy Share Text" snippet. Defaults to https://shipsafe-six-iota.vercel.app
# (set this after adding a custom domain).
NEXT_PUBLIC_SITE_URL=

# Where the "GitHub / Docs" link in the top bar points. Defaults to the on-page #docs section.
NEXT_PUBLIC_DOCS_URL=

# Waitlist notifications (POST /api/waitlist). When both are set, every signup is sent to this Telegram chat.
# 1. Create a bot with @BotFather and copy its token.
# 2. Send the bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
# Server-only secrets: never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot referral program (every 15 invited friends = 10% off, up to 50% at 75 friends). Needs a small Redis-compatible store to count friends.
# Connect "Upstash Redis" from the Vercel Marketplace (free plan) and these are filled in for you.
# Without them the referral screen says "being switched on" and every price stays at the list price.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or a standard Redis connection string (what Vercel's Redis integration provides as REDIS_URL):
REDIS_URL=
